{
  "name": "Win Game - Grand Victory Celebration",
  "description": "Epic celebration animation when player wins the game with all suit themes combined",
  "version": "1.0",
  "cardAnimation": {
    "sequence": [
      {
        "name": "victory_cascade",
        "duration": 3000,
        "easing": "easeInOutQuad",
        "stagger": 100,
        "properties": {
          "translateY": {
            "keyframes": [
              {"time": 0, "value": 0},
              {"time": 0.3, "value": -30},
              {"time": 0.5, "value": -25},
              {"time": 0.7, "value": -15},
              {"time": 1.0, "value": 0}
            ]
          },
          "scale": {
            "keyframes": [
              {"time": 0, "value": 1.0},
              {"time": 0.25, "value": 1.15},
              {"time": 0.5, "value": 1.1},
              {"time": 0.75, "value": 1.05},
              {"time": 1.0, "value": 1.0}
            ]
          },
          "rotation": {
            "keyframes": [
              {"time": 0, "value": 0},
              {"time": 0.25, "value": -8},
              {"time": 0.5, "value": 8},
              {"time": 0.75, "value": -4},
              {"time": 1.0, "value": 0}
            ]
          }
        }
      },
      {
        "name": "rainbow_glow",
        "duration": 3500,
        "easing": "easeInOutSine",
        "properties": {
          "glow": {
            "colorCycle": ["#ff0000", "#ffa500", "#ffff00", "#00ff00", "#0000ff", "#4b0082", "#ee82ee"],
            "cycleDuration": 1000,
            "intensity": {
              "keyframes": [
                {"time": 0, "value": 0},
                {"time": 0.2, "value": 0.9},
                {"time": 0.8, "value": 0.7},
                {"time": 1.0, "value": 0}
              ]
            },
            "blur": 18
          }
        }
      }
    ]
  },
  "particles": {
    "emitters": [
      {
        "name": "confetti_explosion",
        "shape": "rectangle",
        "position": "screen_center",
        "count": 200,
        "duration": 4000,
        "particleLifetime": 3500,
        "colors": ["#ff0000", "#00ff00", "#0000ff", "#ffff00", "#ff00ff", "#00ffff", "#ffa500", "#ff69b4"],
        "size": {
          "width": {"start": 8, "end": 4},
          "height": {"start": 12, "end": 6}
        },
        "opacity": {
          "start": 1.0,
          "end": 0.2
        },
        "velocity": {
          "x": {"min": -200, "max": 200},
          "y": {"min": -250, "max": -100}
        },
        "rotation": {
          "start": 0,
          "end": {"min": -720, "max": 720},
          "speed": 5,
          "randomize": true
        },
        "gravity": 60,
        "airResistance": 0.98,
        "blendMode": "normal"
      },
      {
        "name": "firework_bursts",
        "shape": "star",
        "position": "screen_random",
        "count": 80,
        "burstCount": 5,
        "burstDelay": 400,
        "duration": 3000,
        "particleLifetime": 1500,
        "colors": ["#ffd700", "#ff4500", "#00ffff", "#ff1493", "#00ff00"],
        "size": {
          "start": 10,
          "end": 2
        },
        "opacity": {
          "start": 1.0,
          "end": 0
        },
        "velocity": {
          "x": {"min": -150, "max": 150},
          "y": {"min": -180, "max": -60}
        },
        "gravity": 70,
        "trail": {
          "length": 15,
          "fadeSpeed": 0.9
        },
        "blendMode": "add"
      },
      {
        "name": "golden_coins",
        "shape": "circle",
        "position": "screen_top",
        "count": 60,
        "duration": 3500,
        "particleLifetime": 3000,
        "colors": ["#ffd700", "#ffdf00", "#d4af37", "#f0e68c"],
        "size": {
          "start": 12,
          "end": 8
        },
        "opacity": {
          "start": 1.0,
          "end": 0.4
        },
        "velocity": {
          "x": {"min": -100, "max": 100},
          "y": {"min": -120, "max": -50}
        },
        "rotation": {
          "start": 0,
          "end": {"min": -1080, "max": 1080},
          "speed": 4,
          "randomize": true
        },
        "gravity": 55,
        "bounce": 0.5,
        "metallic": true,
        "blendMode": "normal"
      },
      {
        "name": "victory_stars",
        "shape": "star",
        "position": "screen_edges",
        "count": 100,
        "duration": 3800,
        "particleLifetime": 3200,
        "colors": ["#ffffff", "#fffacd", "#ffd700", "#ffffe0"],
        "size": {
          "start": 8,
          "end": 3
        },
        "opacity": {
          "start": 1.0,
          "end": 0
        },
        "velocity": {
          "x": {"min": -120, "max": 120},
          "y": {"min": -140, "max": -60}
        },
        "gravity": 35,
        "twinkle": {
          "frequency": 7,
          "amplitude": 0.8
        },
        "blendMode": "screen"
      },
      {
        "name": "rainbow_ribbons",
        "shape": "ribbon",
        "position": "screen_around",
        "count": 40,
        "duration": 4000,
        "particleLifetime": 3500,
        "colors": ["#ff0000", "#ffa500", "#ffff00", "#00ff00", "#0000ff", "#4b0082", "#ee82ee"],
        "size": {
          "width": 10,
          "height": {"start": 50, "end": 30}
        },
        "opacity": {
          "start": 0.85,
          "end": 0
        },
        "velocity": {
          "x": {"min": -90, "max": 90},
          "y": {"min": -110, "max": -45}
        },
        "rotation": {
          "start": 0,
          "end": {"min": -540, "max": 540},
          "randomize": true
        },
        "gravity": 48,
        "sway": {
          "amplitude": 40,
          "frequency": 2
        },
        "blendMode": "normal"
      }
    ]
  },
  "audio": {
    "triggerDelay": 300,
    "voiceType": "random_celebration",
    "volume": 0.9,
    "fadeIn": 400,
    "fadeOut": 700,
    "playMultiple": true,
    "maxSimultaneous": 3
  },
  "screenEffects": {
    "flash": {
      "duration": 200,
      "color": "#ffffff",
      "opacity": 0.3
    },
    "shake": {
      "duration": 400,
      "intensity": 8,
      "frequency": 20
    }
  },
  "triggers": {
    "conditions": [
      "game_won",
      "perfect_game",
      "all_suits_complete"
    ]
  }
}
