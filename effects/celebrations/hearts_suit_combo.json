{
  "name": "Hearts Suit Combo - Holly Berries & Love",
  "description": "Hearts suit celebration with holly berries, red hearts, and warm festive particles",
  "version": "1.0",
  "cardAnimation": {
    "sequence": [
      {
        "name": "card_sequence_wave",
        "duration": 1800,
        "easing": "easeInOutSine",
        "stagger": 150,
        "properties": {
          "translateY": {
            "keyframes": [
              {"time": 0, "value": 0},
              {"time": 0.4, "value": -12},
              {"time": 1.0, "value": 0}
            ]
          },
          "scale": {
            "keyframes": [
              {"time": 0, "value": 1.0},
              {"time": 0.35, "value": 1.06},
              {"time": 1.0, "value": 1.0}
            ]
          }
        }
      }
    ]
  },
  "particles": {
    "emitters": [
      {
        "name": "holly_berries",
        "shape": "circle",
        "position": "screen_top",
        "count": 30,
        "duration": 2500,
        "particleLifetime": 2000,
        "colors": ["#dc143c", "#b22222", "#8b0000"],
        "size": {
          "start": 10,
          "end": 6
        },
        "opacity": {
          "start": 1.0,
          "end": 0.3
        },
        "velocity": {
          "x": {"min": -80, "max": 80},
          "y": {"min": -60, "max": -20}
