        "opacity": {
          "start": 0.7,
          "end": 0
        },
        "velocity": {
          "x": {"min": -60, "max": 60},
          "y": {"min": -80, "max": -30}
        },
        "rotation": {
          "start": 0,
          "end": {"min": -180, "max": 180},
          "randomize": true
        },
        "gravity": 30,
        "blendMode": "normal"
      }
    ]
  },
  "audio": {
    "triggerDelay": 200,
    "voiceType": "suit_based",
    "volume": 0.75,
    "fadeIn": 350,
    "fadeOut": 500
  },
  "triggers": {
    "conditions": [
      "hearts_suit_run",
      "hearts_sequence_complete",
      "all_hearts_face_cards"
    ]
