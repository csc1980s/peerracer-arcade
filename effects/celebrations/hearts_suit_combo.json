        "gravity": 50,
        "bounce": 0.3,
        "blendMode": "normal"
      },
      {
        "name": "cascading_hearts",
        "shape": "heart",
        "position": "screen_top",
        "count": 40,
        "duration": 3000,
        "particleLifetime": 2500,
        "colors": ["#ff0000", "#ff1493", "#ff69b4", "#dc143c"],
        "size": {
          "start": 14,
          "end": 8
        },
        "opacity": {
          "start": 0.85,
          "end": 0
        },
        "velocity": {
          "x": {"min": -70, "max": 70},
          "y": {"min": -90, "max": -30}
        },
        "rotation": {
          "start": 0,
          "end": {"min": -90, "max": 90},
          "randomize": true
        },
        "gravity": 35,
        "sway": {
          "amplitude": 25,
          "frequency": 2.5
        },
        "blendMode": "normal"
      },
      {
        "name": "ivy_sparkles",
        "shape": "leaf",
